# --- AWS credentials ---
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Cognito ---
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Only for app clients configured with a secret
COGNITO_CLIENT_SECRET=

# Group granting admin access (optional; defaults to admin)
COGNITO_ADMIN_GROUP=admin

# --- Server ---
# Address and port to listen on (optional; defaults to 127.0.0.1:3000)
BIND_ADDR=127.0.0.1:3000

# Force the Secure attribute on session cookies. Leave unset to derive it from
# the request scheme (X-Forwarded-Proto, else the URI), which is right for both
# local HTTP and a TLS-terminating proxy. Set to 1 when a proxy terminates TLS
# without forwarding the scheme.
SECURE_COOKIES=
